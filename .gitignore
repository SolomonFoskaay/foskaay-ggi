node_modules

# Build output (generated by `npm run build`; Vercel builds it fresh)
dist
# EXCEPTION: the GGI SDK browser bundle is a SHIPPED package asset (it is what a
# plain HTML page loads from the npm CDN), so it must be committed. Everything
# else under a dist/ folder stays ignored.
!packages/sdk/dist/
!packages/sdk/dist/ggi-sdk.browser.js

